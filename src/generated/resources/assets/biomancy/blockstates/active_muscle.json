{
  "multipart": [
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true,
        "x": 180
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true,
        "x": -90
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true,
        "x": -90,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true,
        "x": -90,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    },
    {
      "apply": {
        "model": "biomancy:block/active_muscle",
        "uvlock": true,
        "x": -90,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    }
  ]
}